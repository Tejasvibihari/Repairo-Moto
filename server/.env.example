# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
MONGO_URI=
JWT_SECRET=
ADMIN_JWT_SECRET=
EMPLOYEE_JWT_SECRET=
VENDOR_JWT_SECRET=
USER_JWT_SECRET=

# ── WhatsApp Cloud API (primary login OTP) ──────────────────────────────
# Meta Business Suite → Settings → System users → generate a PERMANENT token
# with the `whatsapp_business_messaging` permission (temporary tokens expire in 24h).

WHATSAPP_ACCESS_TOKEN=

# WhatsApp Manager → API setup → "Phone number ID" (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Optional — defaults shown
WHATSAPP_API_VERSION=v25.0
WHATSAPP_OTP_TEMPLATE=otp
WHATSAPP_OTP_LANGUAGE=en_US
# Optional — attendance alert templates (defaults shown; all English (US) = en_US)
#   employee_attendancemarked · employee_breakstarted · employee_break_ended · employee_signed_out
WHATSAPP_ATTENDANCE_LANGUAGE=en_US
# Customer order-status alert (body: {{1}} name, {{2}} order id, {{3}} message)
WHATSAPP_TPL_ORDER_UPDATE=order_status_update
WHATSAPP_ORDER_LANGUAGE=en_US
WHATSAPP_TPL_CHECK_IN=employee_attendancemarked
WHATSAPP_TPL_BREAK_START=employee_breakstarted
WHATSAPP_TPL_BREAK_END=employee_break_ended
WHATSAPP_TPL_CHECK_OUT=employee_signed_out
# Local testing only: with no WhatsApp credentials, print the OTP in the server console
# instead of falling back to Firebase.
WHATSAPP_OTP_DEV_LOG=false

# ── Firebase Phone Verification (secondary login) ───────────────────────
# Firebase console → Project settings → Project ID  (e.g. repairo-moto-2530e)
FIREBASE_PROJECT_ID=

# ── OTP hashing key (any long random string; falls back to USER_JWT_SECRET) ──
OTP_SECRET=

# ── Distance tracking / customer ETA ──
# Optional. When set, the customer app's "arriving in ~X min" uses Google traffic-aware times
# (Distance Matrix API, cached 90 s per trip). Without it a free speed-based estimate is used.
GOOGLE_MAPS_SERVER_KEY=
# A trip nobody closed is auto-closed after this many hours (default 16)
TRIP_MAX_HOURS=16
